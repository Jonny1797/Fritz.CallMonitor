# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
# Forgejo, read from inside the sandbox (every key in this file is passed into it).
# Use a token with read-only scopes (read:issue, read:repository); the agent
# never writes to Forgejo. Pushing and opening the PR happen on the host with
# the token from .sandcastle/host.env (or ~/.claude.json), see main.mts.
FORGEJO_URL=https://mash.gaja-uranos.de/forgejo
FORGEJO_READ_TOKEN=
